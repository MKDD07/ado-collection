    { url: "https://cpjlcwamma.cloudimg.io/Screenshot_2026_05_23_at_4_16_40_PM_fba943d05a.png", title: "Concierge Highlights", category: "Amenities" },
    { url: "https://cpjlcwamma.cloudimg.io/Eli_Card_Pic_207044cbf9.jpeg", title: "Curated Experiences", category: "Amenities" },
    { url: "https://cpjlcwamma.cloudimg.io/elicard_e3cb1e4ab7.jpeg", title: "Premium Hospitality Card", category: "Amenities" },
    { url: "https://cpjlcwamma.cloudimg.io/DSC_6744_HDR_9cab02bfb3.jpg", title: "Scenic Outdoor Setting", category: "Exterior" },
    { url: "https://cpjlcwamma.cloudimg.io/K81_A7301_55643471fa.jpg", title: "Luxury Bath Setup", category: "Bedrooms" },
    { url: "https://cpjlcwamma.cloudimg.io/DSC_6489_HDR_70b6959fae.jpg", title: "Living Lounge Space", category: "Living" },
    { url: "https://cpjlcwamma.cloudimg.io/DSC_6538_HDR_51352cec00.jpg", title: "Ambient Living Room", category: "Living" },
    { url: "https://cpjlcwamma.cloudimg.io/DSC_6610_HDR_4d6f8c6a98.jpg", title: "Verandah Horizon View", category: "Exterior" },
    { url: "https://cpjlcwamma.cloudimg.io/DSC_6349_HDR_dcf3a14190.jpg", title: "Hallway & Bedroom Entrance", category: "Bedrooms" },
    { url: "https://cpjlcwamma.cloudimg.io/2_8b8200cc9a.jpg", title: "Estate Pavilion", category: "Exterior" },
    { url: "https://cpjlcwamma.cloudimg.io/Dolly_Singh_e61f3988b5.png", title: "Celebrity & Influencer Stays", category: "Amenities" },
    { url: "https://cpjlcwamma.cloudimg.io/3_28399263d0.jpg", title: "Tranquil Verandah", category: "Living" },
    { url: "https://cpjlcwamma.cloudimg.io/DSC_9459_HDR_7d45b04d8e.JPG", title: "Mountain Horizon Panorama", category: "Exterior" },
    { url: "https://cpjlcwamma.cloudimg.io/RNP_05300_2_f0a602116d.jpg", title: "Western Ghats Sunrise", category: "Exterior" },
    { url: "https://cpjlcwamma.cloudimg.io/DJI_20250117130129_0321_D_f96c5441ee.jpg", title: "Aerial Drone Estate View", category: "Exterior" },
    { url: "https://cpjlcwamma.cloudimg.io/DJI_0040_88a07510be.jpg", title: "Aerial Landscape & Western Ghats", category: "Exterior" }
  ]
};

  // Map of all properties by slug
  const allProperties = {
    goa: propertyData_Goa,
    nashik: propertyData_Nashik,
    nasik: propertyData_Nashik,
  };

  // Determine active property based on URL query parameter ?slug=
  const urlParams = new URLSearchParams(window.location.search);
  const activeSlug = (urlParams.get('slug') || 'goa').toLowerCase().trim();
  const rawPropertyData = allProperties[activeSlug] || propertyData_Goa;

  // Auto-normalize image objects in case images is an array of strings or objects
  const propertyData = {
    ...rawPropertyData,
    images: (rawPropertyData.images || []).map((img, i) => {
      if (typeof img === 'string') {
        return { url: img, title: `${rawPropertyData.title || 'Property'} Photo ${i + 1}`, category: 'All' };
      }
      return img;
    })
  };
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  // ---------- Swipers & Gallery Setup ----------

  // ---------- Renderers ----------
  let roomsSwiperInstance = null;

  function initRoomsSwiper() {
    const swiperEl = $('pdpRoomsSwiper');
    if (!swiperEl || typeof Swiper === 'undefined') return;

    if (window.innerWidth < 576) {
      if (!roomsSwiperInstance) {
        roomsSwiperInstance = new Swiper('#pdpRoomsSwiper', {
          slidesPerView: 1.15,
          spaceBetween: 14,
          grabCursor: true,
        });
      }
    } else {
      if (roomsSwiperInstance) {
        roomsSwiperInstance.destroy(true, true);
        roomsSwiperInstance = null;
      }
    }
  }

  function renderRooms() {
    const c = $('pdpRoomsGrid'); if (!c) return;
    c.innerHTML = propertyData.rooms.map(r => `
      <div class="swiper-slide pdp-room-slide">
        <div class="pdp-room-card">
          <div class="pdp-room-top">
            <div class="pdp-room-thumb-wrap" data-photo="${esc(r.photo)}" data-title="${esc(r.title)}" style="cursor:pointer;" title="Click to view photo">
              <img src="${esc(r.photo)}" alt="${esc(r.title)}" loading="lazy" class="pdp-room-thumb">
              
              <!-- Absolute Overlay inside Image: Bed card on Left, Photo button on Right -->
              <div class="pdp-room-img-overlay">
                <div class="pdp-room-bed-card"><i class="fa-solid fa-bed"></i> ${esc(r.bed)}</div>
                <button class="pdp-room-photo-btn" data-photo="${esc(r.photo)}" data-title="${esc(r.title)}">
                  <i class="fa-regular fa-image"></i> View Photo
                </button>
              </div>
            </div>
            <div class="pdp-room-header">
              <h4 class="pdp-room-title">${esc(r.title)}</h4>
            </div>
            <ul class="pdp-room-bullets">${r.bullets.map(b => `<li>${esc(b)}</li>`).join('')}</ul>
          </div>
        </div>
      </div>`).join('');

    setTimeout(initRoomsSwiper, 50);
  }

  function renderExperiences() {
    const c = $('pdpExperiencesGrid'); if (!c) return;
    c.innerHTML = propertyData.experiences.map(e => `
      <div class="pdp-exp-card">
        <img src="${esc(e.img)}" alt="${esc(e.title)}" loading="lazy">
        <div class="pdp-exp-body">
          <h5 class="pdp-exp-title">${esc(e.title)}</h5>
          <p class="pdp-exp-desc">${esc(e.desc)}</p>
        </div>
      </div>`).join('');
  }

  const swiperInstances = {};

  function initSingleSwiper(selector, prevBtn, nextBtn, paginationEl) {
    if (typeof Swiper === 'undefined') return;
    const swiperEl = document.querySelector(selector);
    if (!swiperEl) return;

    if (swiperInstances[selector]) {
      swiperInstances[selector].destroy(true, true);
      delete swiperInstances[selector];
    }
    swiperInstances[selector] = new Swiper(selector, {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: false,
      navigation: {
        prevEl: prevBtn,
        nextEl: nextBtn
      },
      pagination: paginationEl ? {
        clickable: true
      } : false,
      breakpoints: {
        320: {
          slidesPerView: 1.2,
          spaceBetween: 15
        },
        576: {
          slidesPerView: 2,
          spaceBetween: 20
        },
        992: {
          slidesPerView: 3,
          spaceBetween: 24
        },
        1200: {
          slidesPerView: 4,
          spaceBetween: 24
        }
      }
    });
  }

  function initAllSwipers() {
    initSingleSwiper('#pdpSwiper1', '#pdpPrevBtn1', '#pdpNextBtn1', '#pdpPagination1');
    initSingleSwiper('#pdpSwiper2', '#pdpPrevBtn2', '#pdpNextBtn2', '#pdpPagination2');
    initSingleSwiper('#pdpSwiper3', '#pdpPrevBtn3', '#pdpNextBtn3', '#pdpPagination3');
  }

  // ---------- Mobile Gallery Thumbnail Swiper ----------
  let mobileThumbSwiperInstance = null;

  function renderMobileGallerySwiper(images) {
    const thumbWrapper = $('pdpMobileThumbWrapper');
    const featuredImg = $('pdpMobileFeaturedImg');
    if (!thumbWrapper || !images || !images.length) return;

    if (featuredImg && images[0]?.url) {
      featuredImg.src = images[0].url;
      featuredImg.alt = images[0].title || 'Property Featured Photo';
    }

    thumbWrapper.innerHTML = images.map((img, idx) => `
      <div class="swiper-slide pdp-thumb-slide ${idx === 0 ? 'active-thumb' : ''}" data-index="${idx}" data-src="${esc(img.url)}" data-title="${esc(img.title || '')}">
        <img src="${esc(img.url)}" alt="${esc(img.title || 'Thumbnail')}" loading="lazy" referrerpolicy="no-referrer">
      </div>
    `).join('');

    // Setup or update Swiper instance
    if (mobileThumbSwiperInstance) {
      mobileThumbSwiperInstance.update();
    } else if (typeof Swiper !== 'undefined' && $('pdpMobileThumbSwiper')) {
      mobileThumbSwiperInstance = new Swiper('#pdpMobileThumbSwiper', {
        slidesPerView: 'auto',
        spaceBetween: 8,
        freeMode: true,
        grabCursor: true,
        slideToClickedSlide: true,
        observer: true,
        observeParents: true
      });
    }

    // Attach click listeners to thumbnails to change featured image
    const thumbSlides = thumbWrapper.querySelectorAll('.pdp-thumb-slide');
    thumbSlides.forEach(slide => {
      slide.addEventListener('click', (e) => {
        e.stopPropagation();
        const src = slide.dataset.src;
        const title = slide.dataset.title;
        if (src && featuredImg) {
          featuredImg.style.opacity = '0.35';
          setTimeout(() => {
            featuredImg.src = src;
            if (title) featuredImg.alt = title;
            featuredImg.style.opacity = '1';
          }, 150);
        }
        thumbSlides.forEach(s => s.classList.remove('active-thumb'));
        slide.classList.add('active-thumb');
      });
    });
  }

  // ---------- Full-Screen Gallery Modal Logic ----------
  let fsModalImages = [];
  let fsModalCurrentIdx = 0;
  let fsThumbSwiperInstance = null;

  function openFullscreenGallery(startIndex = 0, category = 'All') {
    const modal = $('pdpGalleryModal');
    if (!modal) return;

    fsModalImages = category === 'All' ? propertyData.images : propertyData.images.filter(i => i.category === category);
    if (!fsModalImages.length) fsModalImages = propertyData.images;

    fsModalCurrentIdx = Math.max(0, Math.min(startIndex, fsModalImages.length - 1));
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';

    // Update active category pill
    document.querySelectorAll('.pdp-fs-cat-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.category === category);
    });

    renderFsThumbnails();
    showFsImage(fsModalCurrentIdx);
  }

  function showFsImage(index) {
    if (!fsModalImages || !fsModalImages.length) return;
    fsModalCurrentIdx = (index + fsModalImages.length) % fsModalImages.length;
    const item = fsModalImages[fsModalCurrentIdx];

    const imgEl = $('pdpFsFeaturedImg');
    const capEl = $('pdpFsCaption');
    const countEl = $('pdpFsCounter');

    if (imgEl && item) {
      imgEl.style.opacity = '0.3';
      setTimeout(() => {
        imgEl.src = item.url;
        imgEl.alt = item.title || 'Property photo';
        imgEl.style.opacity = '1';
      }, 120);
    }

    if (capEl) capEl.textContent = item?.title || 'Foresta By The Lake';
    if (countEl) countEl.textContent = `${fsModalCurrentIdx + 1} / ${fsModalImages.length}`;

    // Highlight thumbnail
    const thumbSlides = document.querySelectorAll('.pdp-fs-thumb-slide');
    thumbSlides.forEach((slide, idx) => {
      slide.classList.toggle('active-fs-thumb', idx === fsModalCurrentIdx);
    });

    if (fsThumbSwiperInstance && typeof fsThumbSwiperInstance.slideTo === 'function') {
      fsThumbSwiperInstance.slideTo(fsModalCurrentIdx);
    }
  }

  function renderFsThumbnails() {
    const wrapper = $('pdpFsThumbWrapper');
    if (!wrapper || !fsModalImages) return;

    wrapper.innerHTML = fsModalImages.map((img, idx) => `
      <div class="swiper-slide pdp-fs-thumb-slide ${idx === fsModalCurrentIdx ? 'active-fs-thumb' : ''}" data-idx="${idx}">
        <img src="${esc(img.url)}" alt="${esc(img.title || '')}" loading="lazy" referrerpolicy="no-referrer">
      </div>
    `).join('');

    if (fsThumbSwiperInstance) {
      fsThumbSwiperInstance.destroy(true, true);
      fsThumbSwiperInstance = null;
    }

    if (typeof Swiper !== 'undefined' && $('pdpFsThumbSwiper')) {
      fsThumbSwiperInstance = new Swiper('#pdpFsThumbSwiper', {
        slidesPerView: 'auto',
        spaceBetween: 10,
        freeMode: true,
        grabCursor: true,
        slideToClickedSlide: true,
        centeredSlides: false
      });
    }

    wrapper.querySelectorAll('.pdp-fs-thumb-slide').forEach(slide => {
      slide.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(slide.dataset.idx, 10);
        if (!isNaN(idx)) showFsImage(idx);
      });
    });
  }

  function closeFullscreenGallery() {
    const modal = $('pdpGalleryModal');
    if (modal) modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  function openPhotoModal(url, title) {
    const idx = propertyData.images.findIndex(i => i.url === url);
    openFullscreenGallery(idx >= 0 ? idx : 0, 'All');
  }

  // ---------- Init ----------
  function initPdp() {
    window.pdpData = propertyData;

    if (typeof lucide !== 'undefined' && lucide.createIcons) {
      lucide.createIcons();
    }

    renderMobileGallerySwiper(propertyData.images);

    // Initialize all 3 static swipers
    initAllSwipers();

    const modal = $('pdpGalleryModal');
    const closeBtn = $('pdpModalClose');
    const prevBtn = $('pdpFsPrevBtn');
    const nextBtn = $('pdpFsNextBtn');

    // Click on desktop gallery grid (.pdp-gallery-grid) opens modal at corresponding photo
    const galleryMain = document.querySelector('.pdp-gallery-main');
    galleryMain?.addEventListener('click', () => openFullscreenGallery(0, 'All'));

    const gallerySideBoxes = document.querySelectorAll('.pdp-gallery-side .pdp-img-box');
    if (gallerySideBoxes[0]) gallerySideBoxes[0].addEventListener('click', () => openFullscreenGallery(1, 'All'));
    if (gallerySideBoxes[1]) gallerySideBoxes[1].addEventListener('click', () => openFullscreenGallery(2, 'All'));

    // "All Photos" button and any general .pdp-open-modal triggers
    document.querySelectorAll('.pdp-all-photos-btn').forEach(b => {
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        openFullscreenGallery(0, 'All');
      });
    });

    closeBtn?.addEventListener('click', closeFullscreenGallery);
    modal?.addEventListener('click', e => {
      if (e.target === modal || e.target.classList.contains('pdp-fs-modal-wrap') || e.target.classList.contains('pdp-fs-stage')) {
        closeFullscreenGallery();
      }
    });

    // Next / Prev buttons
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showFsImage(fsModalCurrentIdx - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showFsImage(fsModalCurrentIdx + 1);
    });

    // Keyboard navigation (Arrow keys + Escape)
    document.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('active')) return;
      if (e.key === 'ArrowLeft') showFsImage(fsModalCurrentIdx - 1);
      if (e.key === 'ArrowRight') showFsImage(fsModalCurrentIdx + 1);
      if (e.key === 'Escape') closeFullscreenGallery();
    });

    // Category filter pills in modal
    const catBtns = document.querySelectorAll('.pdp-fs-cat-btn');
    catBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        openFullscreenGallery(0, btn.dataset.category);
      });
    });

    // Event delegation
    document.addEventListener('click', e => {
      const photoBtn = e.target.closest('.pdp-room-photo-btn') || e.target.closest('.pdp-room-thumb-wrap');
      if (photoBtn) return openPhotoModal(photoBtn.dataset.photo, photoBtn.dataset.title);

      const hotelLinkBtn = e.target.closest('[data-hotel-link]');
      if (hotelLinkBtn && hotelLinkBtn.dataset.hotelLink) {
        return window.open(hotelLinkBtn.dataset.hotelLink, '_blank', 'noopener');
      }

      const card = e.target.closest('[data-open]');
      if (card) return window.open(card.dataset.open, '_blank', 'noopener');
    });

    // Tabs
    const navTabsContainer = document.querySelector('.pdp-nav-tabs');
    const navTabs = document.querySelectorAll('.pdp-tab-item');
    const panes = document.querySelectorAll('.pdp-tab-pane');

    // Tab switching and auto-scroll active tab into view
    navTabs.forEach(t => t.addEventListener('click', () => {
      navTabs.forEach(x => x.classList.remove('active'));
      t.classList.add('active');
      panes.forEach(p => p.classList.toggle('active', p.id === t.dataset.target));

      // Scroll clicked tab into view within the horizontal container
      if (navTabsContainer) {
        const tabOffset = t.offsetLeft - navTabsContainer.offsetLeft - 16;
        navTabsContainer.scrollTo({ left: Math.max(0, tabOffset), behavior: 'smooth' });
      }
    }));

    // Mouse drag-to-scroll and mouse wheel support for horizontal tabs
    if (navTabsContainer) {
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let hasMoved = false;

      navTabsContainer.addEventListener('mousedown', (e) => {
        isDown = true;
        hasMoved = false;
        startX = e.pageX - navTabsContainer.offsetLeft;
        scrollLeft = navTabsContainer.scrollLeft;
      });

      navTabsContainer.addEventListener('mouseleave', () => {
        isDown = false;
      });

      navTabsContainer.addEventListener('mouseup', () => {
        isDown = false;
      });

      navTabsContainer.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - navTabsContainer.offsetLeft;
        const walk = (x - startX) * 1.5; // Scroll speed multiplier
        if (Math.abs(walk) > 3) hasMoved = true;
        navTabsContainer.scrollLeft = scrollLeft - walk;
      });

      // Mouse wheel horizontal scrolling
      navTabsContainer.addEventListener('wheel', (e) => {
        if (e.deltaY !== 0) {
          e.preventDefault();
          navTabsContainer.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      // Arrow navigation buttons
      const arrowLeft = $('pdpTabsArrowLeft');
      const arrowRight = $('pdpTabsArrowRight');

      function updateTabsArrows() {
        if (!navTabsContainer) return;
        const maxScroll = navTabsContainer.scrollWidth - navTabsContainer.clientWidth - 2;
        const currentScroll = navTabsContainer.scrollLeft;

        if (arrowLeft) {
          arrowLeft.classList.toggle('visible', currentScroll > 10);
        }
        if (arrowRight) {
          arrowRight.classList.toggle('visible', maxScroll > 10 && currentScroll < maxScroll);
        }
      }

      arrowLeft?.addEventListener('click', () => {
        navTabsContainer.scrollBy({ left: -180, behavior: 'smooth' });
      });

      arrowRight?.addEventListener('click', () => {
        navTabsContainer.scrollBy({ left: 180, behavior: 'smooth' });
      });

      navTabsContainer.addEventListener('scroll', updateTabsArrows);
      window.addEventListener('resize', updateTabsArrows);
      setTimeout(updateTabsArrows, 100);
    }

    // Map Lock Overlay
    const mapWrapper = document.querySelector('.pdp-map-wrapper');
    const mapLock = document.querySelector('.pdp-map-lock-overlay');
    if (mapWrapper && mapLock) {
      mapWrapper.addEventListener('mouseleave', () => {
        mapLock.classList.remove('unlocked');
      });
    }

    // Booking actions
    $('pdpCheckBtn')?.addEventListener('click', () => alert('Checking live availability for Foresta By The Lake for selected dates...'));
    $('pdpSendBtn')?.addEventListener('click', () => {
      const msg = prompt('Enter your inquiry or question for Foresta By The Lake:');
      if (msg) alert('Thank you! Our concierge team will get back to you shortly.');
    });

    // SEO Category Pills Switcher
    const seoCatBtns = document.querySelectorAll('.pdp-seo-cat-btn');
    seoCatBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        seoCatBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    // Mobile SEO Directory Accordions
    const accordionHeaders = document.querySelectorAll('.pdp-seo-accordion-header');
    accordionHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const body = header.nextElementSibling;
        if (!body) return;
        
        const isOpen = body.classList.contains('open');
        header.classList.toggle('active', !isOpen);
        body.classList.toggle('open', !isOpen);
      });
    });

    // Mobile Location Column Dropdown Accordions (<576px)
    const locTitles = document.querySelectorAll('.pdp-seo-loc-title');
    locTitles.forEach(title => {
      title.addEventListener('click', () => {
        if (window.innerWidth <= 576) {
          const col = title.closest('.pdp-seo-loc-col');
          if (col) col.classList.toggle('open');
        }
      });
    });

    // Mobile Fixed Right Inquiry Button & Slide-in Bottom Popup (<576px)
    const mobileInquiryBtn = $('pdpMobileFixedInquiryBtn');
    const inquiryCloseBtn = $('pdpInquiryCloseBtn');
    const inquiryBackdrop = $('pdpInquiryBackdrop');
    const inquiryForm = $('pdpInquiryForm');

    function openInquiryModal() {
      document.body.classList.add('pdp-inquiry-modal-open');
    }
    function closeInquiryModal() {
      document.body.classList.remove('pdp-inquiry-modal-open');
    }

    mobileInquiryBtn?.addEventListener('click', openInquiryModal);
    inquiryCloseBtn?.addEventListener('click', closeInquiryModal);
    inquiryBackdrop?.addEventListener('click', closeInquiryModal);
    inquiryForm?.addEventListener('submit', () => {
      setTimeout(closeInquiryModal, 400);
    });

    window.addEventListener('resize', () => {
      initRoomsSwiper();
    });


    // Sync input values between main search bar and header search bar
    if (heroSearchForm && stickyHeaderForm) {
      ['slug', 'checkin', 'checkout', 'guests'].forEach(field => {
        const heroInput = heroSearchForm.querySelector(`[name="${field}"]`);
        const headerInput = stickyHeaderForm.querySelector(`[name="${field}"]`);
        if (heroInput && headerInput) {
          heroInput.addEventListener('change', () => headerInput.value = heroInput.value);
          headerInput.addEventListener('change', () => heroInput.value = headerInput.value);
        }
      });
    }

    // Floating Location Widget Toggle
    const floatToggle = $('pdpFloatingLocToggle');
    const floatMenu = $('pdpFloatingLocMenu');
    if (floatToggle && floatMenu) {
      floatToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isVisible = floatMenu.style.display !== 'none';
        floatMenu.style.display = isVisible ? 'none' : 'flex';
        floatToggle.style.transform = isVisible ? 'scale(1)' : 'scale(1.08) rotate(45deg)';
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#pdpFloatingLocWidget') && floatMenu) {
          floatMenu.style.display = 'none';
          if (floatToggle) floatToggle.style.transform = 'scale(1)';
        }
      });
    }

    // Handle Location Switcher Active State based on URL ?slug= parameter
    const urlParams = new URLSearchParams(window.location.search);
    const activeSlug = urlParams.get('slug') || propertyData.slug || 'goa';
    const locPills = document.querySelectorAll('.pdp-loc-pill');
    locPills.forEach(pill => {
      const pillSlug = pill.getAttribute('data-slug');
      if (pillSlug === activeSlug) {
        pill.classList.add('active');
        if (pill.classList.contains('pdp-float-loc-item')) {
          pill.style.background = '#0f172a';
          pill.style.color = '#ffffff';
        } else {
          pill.style.background = '#0f172a';
          pill.style.color = '#ffffff';
          pill.style.border = 'none';
        }
        const titleAttr = pill.getAttribute('data-title');
      } else {
        pill.classList.remove('active');
        if (pill.classList.contains('pdp-float-loc-item')) {
          pill.style.background = '#ffffff';
          pill.style.color = '#1e293b';
        } else {
          pill.style.background = '#ffffff';
          pill.style.color = '#334155';
          pill.style.border = '1px solid #cbd5e1';
        }
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPdp);
  else initPdp();
})();